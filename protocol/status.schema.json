{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blend-to-colab.example/protocol/1.0/status.schema.json",
  "title": "Blend-to-Colab worker status",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol_version", "job_id", "revision", "state", "updated_at", "worker_version", "progress", "device", "message", "error"],
  "properties": {
    "protocol_version": {"const": "1.0"}, "job_id": {"type": "string", "format": "uuid"}, "revision": {"type": "integer", "minimum": 1}, "state": {"enum": ["PREFLIGHT", "RENDERING", "PARTIAL", "COMPLETE", "FAILED"]}, "updated_at": {"type": "string", "format": "date-time"}, "worker_version": {"type": "string", "minLength": 1}, "progress": {"type": "object", "required": ["completed_frames", "total_frames", "current_frame"], "properties": {"completed_frames": {"type": "integer", "minimum": 0}, "total_frames": {"type": "integer", "minimum": 0}, "current_frame": {"type": ["integer", "null"], "minimum": 0}}}, "device": {"type": "object"}, "message": {"type": "string"}, "error": {"type": ["object", "null"]}
  }
}
